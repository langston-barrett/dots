#!/usr/bin/env bash
if [[ ${1} == *"://"* ]]; then
  git clone "${1}" && cd "${1}"
elif [[ ${1} == *"/"* ]]
  git clone https://github.com/"{1}"
  cd "$(basename "${1}")"
else
  (git clone https://github.com/langston-barrett/"{1}" || \
    git clone https://github.com/GaloisInc/"{1}") && \
    cd "${1}"
fi
