#!/usr/bin/env bash

# shellcheck disable=SC2016

set -euo pipefail

docs="\
A: Add task
B: Blocked by
D: Done
E: Edit
F: Filter
H: High priority
L: Low priority
M: Medium priority
P: Project
R: Reload
S: Start
T: Stop
U: Unset priority
?: Help
"
    # --bind="F:execute(hx ~/.local/share/task/filter)+clear-query+reload(task-table)" \
task-table | \
  pick \
    --preview='task {1} information | rg "^(Description|Status|Issue|Priority|Project|Parent|Tags|This task is blocking)"' \
    --preview-window=up,8,wrap \
    --delimiter='\t' \
    --accept-nth='{1}' \
    --with-nth='{6} {4} {3} {2}' \
    --multi \
    --header-first \
    --header ' ' \
    --bind 'start:+transform-header:bat ~/.local/share/task/filter' \
    --bind 'load:+transform-header:bat ~/.local/share/task/filter' \
    --style=full \
    --bind="bspace:backward-delete-char/eof" \
    --bind="A:execute(task add {q})+reload(task-table)" \
    --bind='B:execute(task {1} modify depends:$(tasks --bind=enter:accept))+clear-query+reload(task-table)' \
    --bind="D:execute(task {1} done)+clear-query+reload(task-table)" \
    --bind="E:execute(task {1} edit)+clear-query+reload(task-table)" \
    --bind='F:execute(task-filter > ~/.local/share/task/filter)+reload(task-table)' \
    --bind="H:execute(task {1} modify priority:high)+reload(task-table)" \
    --bind="L:execute(task {1} modify priority:low)+reload(task-table)" \
    --bind="M:execute(task {1} modify priority:med)+reload(task-table)" \
    --bind='P:execute(task {1} modify project:$(printf "bracelet\ndots\ndetect\ngrease" | pick))+clear-query+reload(task-table)' \
    --bind="R:reload(task-table)" \
    --bind="S:execute(task {1} start)+clear-query+reload(task-table)" \
    --bind="T:execute(task {1} stop)+clear-query+reload(task-table)" \
    --bind="U:execute(task {1} modify priority:)+reload(task-table)" \
    --bind="X:execute(task {1} delete)+clear-query+reload(task-table)" \
    --bind="Z:clear-query" \
    --bind="?:execute(echo '${docs}' | bat --plain --paging=always)+reload(task-table)" \
    --bind="enter:execute(task add {q})+reload(task-table)" \
    --bind="ctrl-r:reload(task-table)" \
    "${@}"
