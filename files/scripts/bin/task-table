#!/usr/bin/env bash

set -euo pipefail

tmp=$(mktemp)
# Note that spaces are the character "⠀", not regular space
bat > "${tmp}" <<'EOF'
def pad_left($len; $chr):
    (tostring | length) as $l
    | "\($chr * ([$len - $l, 0] | max) // "")\(.)"
    ;
def pad_left($len):
    pad_left($len; " ")
    ;

.[]
| [ .uuid
  , .description
  , (.depends[0] | length | if . == 0 then "⠀" else "B" end)
  , (.priority | .[0:1] // "⠀")
  , (.id | pad_left(2))
  , (.project // "⠀" | .[0:3] | pad_left(3))
  , .urgency | pad_left(5)
  ]
| join ("\t")
EOF

if ! [[ -f ~/.local/share/task/filter ]]; then
  mkdir -p ~/.local/share/task
  printf 'status:pending\n' > ~/.local/share/task/filter
fi
task ${1:-$(bat ~/.local/share/task/filter)} export | \
  jq -r -f "${tmp}" | \
  sort --numeric-sort --reverse --key=7 --field-separator=$'\t'
