#!/usr/bin/env bash

set -euo pipefail

tmp=$(mktemp)
# Empty-field placeholders use a middle dot (·): a visible, single-cell glyph
# present in essentially every monospace font, so empty cells hold their column
# width regardless of the terminal font. (A blank glyph like U+00A0 NBSP is
# prettier but font-dependent — full blank cell in some fonts, collapsed to
# nothing in others, which misaligns the table.)
bat > "${tmp}" <<'EOF'
def pad_left($len; $chr):
    (tostring | length) as $l
    | "\($chr * ([$len - $l, 0] | max) // "")\(.)"
    ;
def pad_left($len):
    pad_left($len; " ")
    ;

.[]
| [ .uuid
  , .description
  , (.depends[0] | length | if . == 0 then "·" else "B" end)
  , (.priority | .[0:1] // "·")
  , (.id | pad_left(2))
  , (.project // "·" | .[0:3] | pad_left(3))
  , (.urgency | tostring | .[0:3] | pad_left(3))
  ]
| join ("\t")
EOF

if ! [[ -f ~/.local/share/task/filter ]]; then
  mkdir -p ~/.local/share/task
  printf 'status:pending\n' > ~/.local/share/task/filter
fi
# shellcheck disable=SC2086
task ${1:-$(bat ~/.local/share/task/filter)} export | \
  jq -r -f "${tmp}" | \
  sort --numeric-sort --reverse --key=7 --field-separator=$'\t'
