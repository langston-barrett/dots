{
  "permissions": {
    "allow": [
      "Bash(cabal build:*)",
      "Bash(cabal run:*)",
      "Bash(cabal test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "Bash(cargo test:*)",
      "Bash(cat:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(df:*)",
      "Bash(diff:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(whoami:*)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notify \"AI needs help\""
          },
          {
            "type": "command",
            "command": "mkdir -p ~/.config/kludge/sentinels; T=$(date +%s); P=$(basename \"$PWD\"); H=$(hostname); F=$(echo \"$PWD\" | tr '/' '-'); printf '{\"type\":\"ai_feedback\",\"description\":\"AI in %s needs feedback\",\"created_at\":%s,\"metadata\":{\"project\":\"%s\",\"project_path\":\"%s\",\"hostname\":\"%s\",\"sessions_dir\":\"%s\"}}\\n' \"$P\" \"$T\" \"$P\" \"$PWD\" \"$H\" \"$HOME/.claude/projects\" > ~/.config/kludge/sentinels/ai-${F}.json"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "kludge format"
          }
        ]
      },
      {
        "matcher": "Bash.*git commit",
        "hooks": [
          {
            "type": "command",
            "command": "kludge postcommit"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "rm -f ~/.config/kludge/sentinels/ai-*.json ~/.config/kludge/sentinels/claude-*.json"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true
}
